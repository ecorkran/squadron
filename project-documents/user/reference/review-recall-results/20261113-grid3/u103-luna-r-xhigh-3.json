      "category": "correctness",
      "raw_category": null,
      "location": "src/chart/use-chart-provider.ts:341"
    },
    {
      "severity": "CONCERN",
      "title": "Preserve the first operation error",
      "description": "`setOperationError` unconditionally replaces `current.error`, so a later provider failure overwrites the earlier one. This conflicts with `UseChartProviderResult.error`\u2019s documented contract of retaining the first operation error and can replace the original failure shown to the user.",
