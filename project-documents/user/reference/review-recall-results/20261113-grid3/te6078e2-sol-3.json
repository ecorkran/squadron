    {
      "severity": "CONCERN",
      "title": "Integer coercion silently rounds before validation",
      "description": "`as_integer` converts non-integral `Real` inputs to float before checking integrality. Reproduced: `Fraction(9007199254740993)` becomes `9007199254740992`, and fractional `Fraction(18014398509481985, 2)` is accepted as that same integer. Parameter binding consequently can silently change supplied values. Restrict accepted types or verify exact integrality before conversion, and add regression tests.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "src/manta_trading_engine/core_model/value_checks.py:65-70"
    },
    {
      "severity": "CONCERN",
      "title": "Invalid timestamp meanings escape the typed error contract",
      "description": "`Timestamp` does not validate its `meaning` field. Passing `Timestamp(1, \"available_at\")` into `SignalEvent` therefore raises `AttributeError` while formatting `.meaning.value`, rather than `InvalidSignalError`. Validate the meaning\u2019s type before accessing `.value`, or report its `repr`; add tests for string and `None` meanings.",
      "file_ref": null,
      "category": "error-handling-observability",
      "raw_category": null,
