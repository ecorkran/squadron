  "findings": [
    {
      "severity": "CONCERN",
      "title": "Integer coercion can silently truncate fractional real values",
      "description": "`as_integer` converts a `Real` to `float` before checking whether it is integral. A fractional `Fraction`, such as `Fraction(9007199254740993, 9007199254740992)`, rounds to `1.0`; the check then accepts it and returns `1`. This can silently bind a different parameter value than the caller supplied. Check integrality without losing precision during float conversion.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "src/manta_trading_engine/core_model/value_checks.py:67-70"
    },
    {
      "severity": "CONCERN",
      "title": "Invalid timestamp meaning can escape as `AttributeError`",
      "description": "`Timestamp` checks its nanoseconds but does not validate that `meaning` is a `TimeMeaning`. If a timestamp has a malformed meaning, this branch tries to access `self.time.meaning.value` while constructing the intended `InvalidSignalError`, and can instead raise `AttributeError`. Validate the meaning before reading `.value` so malformed input consistently raises the domain error.",
      "file_ref": null,
      "category": "error-handling-observability",
      "raw_category": null,
      "location": "src/manta_trading_engine/core_model/signals.py:76-79"
    }
