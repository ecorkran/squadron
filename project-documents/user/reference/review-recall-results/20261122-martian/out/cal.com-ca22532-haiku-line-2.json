    {
      "severity": "CONCERN",
      "title": "`sed -i ''` uses BSD-only syntax and fails on GNU/Linux",
      "description": "The in-place edit `sed -i '' -E \"s|^GOOGLE_WEBHOOK_URL=.*|GOOGLE_WEBHOOK_URL=$TUNNEL_URL|\" \"$ENV_FILE\"` passes an empty backup suffix, which is required by macOS/BSD sed. GNU sed reads `''` as the script and then fails on the expression. The script only works on Darwin, and nothing in the diff documents that.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "scripts/test-gcal-webhooks.sh:68"
    },
    {
      "severity": "CONCERN",
      "title": "`ENV_FILE` is resolved relative to the current directory, not the script",
      "description": "`ENV_FILE=\"../.env\"` is a relative path, so it resolves against wherever the script is invoked. Run from the repo root, it writes `GOOGLE_WEBHOOK_URL` to a `.env` outside the repository. Run from `scripts/`, it writes to the repo-root `.env`. The path should be derived from the script's own location, or the working directory should be documented.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "scripts/test-gcal-webhooks.sh:5"
    }
