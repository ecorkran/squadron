  "findings": [
    {
      "severity": "CONCERN",
      "title": "Access-token matcher does not validate the expected grant",
      "description": "The grant occupies indices `[4, 6)`, but the matcher reads `[3, 5)` and returns `false` when that substring **equals** the expected grant. Consequently, an authorization-code expectation accepts a refresh-token ID such as `onrtrt:<UUID>`. Short prefixes can also throw instead of returning a mismatch. Validate the six-character prefix length and reject when `substring(4, 6)` does **not** equal the expected shortcut.",
      "file_ref": null,
      "category": "test-debt",
      "raw_category": null,
      "location": "testsuite/integration-arquillian/tests/base/src/test/java/org/keycloak/testsuite/AssertEvents.java:483"
    },
    {
      "severity": "CONCERN",
      "title": "Invalid-grant test passes because of an unrelated NullPointerException",
      "description": "The fixture never calls `postInit`, leaving the factory\u2019s `sessionFactory` null. Looking up the unregistered `ac` shortcut enters `getGrantTypeByShortcut`\u2019s fallback and throws `NullPointerException`. Catching any `RuntimeException` makes the test pass without exercising the intended unknown-grant rejection. Supply a session-factory mock returning no matching grants and assert specifically that decoding throws `IllegalArgumentException`.",
      "file_ref": null,
      "category": "test-debt",
      "raw_category": null,
      "location": "services/src/test/java/org/keycloak/protocol/oidc/encode/DefaultTokenContextEncoderProviderTest.java:77-84"
    },
    {
      "severity": "CONCERN",
      "title": "Grant shortcuts can violate the decoder\u2019s fixed-width format",
      "description": "The factory accepts shortcuts of any length, while `DefaultTokenContextEncoderProvider.getTokenContextFromTokenId` requires exactly six prefix characters and reserves exactly two for the grant. A custom grant using a three-character shortcut\u2014as suggested by `OAuth2GrantTypeFactory.getShortcut`\u2019s documentation\u2014can issue IDs that this decoder always rejects. Enforce two-character shortcuts during registration and dynamic lookup, update the interface contract, and test invalid lengths.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "services/src/main/java/org/keycloak/protocol/oidc/encode/DefaultTokenContextEncoderProviderFactory.java:74-76"
    },
    {
      "severity": "CONCERN",
      "title": "Constructor validates grantType twice instead of validating rawTokenId",
      "description": "The final `requireNonNull` checks `grantType` again, allowing a null `rawTokenId` despite the stated invariant. Encoding that context silently produces an ID ending in `:null`. Check `rawTokenId` instead and add a constructor test for this case.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "services/src/main/java/org/keycloak/protocol/oidc/encode/AccessTokenContext.java:73"
    }
