  "verdict": "CONCERNS",
  "findings": [
    {
      "severity": "CONCERN",
      "title": "Test-image build fails for any base image that predates `rolling-updates`",
      "description": "The Dockerfile now runs `kc.sh build ... --features=rolling-updates` on `FROM $IMAGE:$VERSION`. `operator/scripts/build-testing-docker-images.sh:4-6` defaults `VERSION` to `latest` and the base image to `quay.io/keycloak/keycloak`, and `operator/README.md:114` documents passing a released `SOURCE KEYCLOAK IMAGE TAG`. A released image that does not know this feature will reject the option. `FeaturePropertyMappers.validateEnabledFeature` (`quarkus/runtime/src/main/java/org/keycloak/quarkus/runtime/configuration/mappers/FeaturePropertyMappers.java:34-50`) throws `PropertyException` for any name not in `Profile.Feature`, so `docker build` aborts. CI is not affected: `.github/workflows/operator-ci.yml:88-89` and `:132-133` build the base image from the local dist. The break is for the documented manual invocation with a released tag. This is inferred from reading the validator, not from a run.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "operator/scripts/Dockerfile-custom-image:5"
    },
    {
      "severity": "NOTE",
      "title": "Exit code 4 is renumbered, and every invocation without the feature now exits 4",
      "description": "`RECREATE_UPGRADE_EXIT_CODE` moves from 4 to 3, and 4 becomes `FEATURE_DISABLED`. `IncompatibleResult.exitCode()` (`IncompatibleResult.java:35`) now returns 3. The docs table in `docs/guides/server/update-compatibility.adoc:128-134` already listed 3 for \"not possible, shut down\" and now lists 4 for \"feature disabled\", so the code now matches the documentation. Scripts that were written against the shipped behavior (recreate = 4) will misread both results. Also, `check` and `metadata` without `--features=rolling-updates` now exit 4 instead of running, which is intended for a preview gate but is a breaking change for existing preview users.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "quarkus/runtime/src/main/java/org/keycloak/quarkus/runtime/compatibility/CompatibilityResult.java:34"
    }
  ],
