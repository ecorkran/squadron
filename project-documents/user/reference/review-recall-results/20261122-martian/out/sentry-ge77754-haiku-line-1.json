  "findings": [
    {
      "severity": "CONCERN",
      "title": "`queued` default is evaluated once at import, so every AssignmentSource shares one timestamp",
      "description": "The field `queued: datetime = timezone.now()` calls `timezone.now()` when the class body is executed, not per instance. Every `AssignmentSource` created in the process will carry the module-load time. Use `dataclasses.field(default_factory=timezone.now)` so each instance gets its own timestamp.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "src/sentry/integrations/services/assignment_source.py:18"
    },
    {
      "severity": "CONCERN",
      "title": "`to_dict()` puts a datetime into task kwargs that may not serialize",
      "description": "`AssignmentSource.to_dict()` uses `dataclasses.asdict`, which keeps `queued` as a `datetime`. That dict is passed as `assignment_source_dict` in `apply_async(kwargs=...)`. If the Celery serializer is JSON, which is common, enqueueing will fail. Either serialize `queued` to an ISO string in `to_dict()` and parse it back in `from_dict()`, or leave it out of the payload.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "src/sentry/integrations/utils/sync.py#sync_group_assignee_outbound"
    },
