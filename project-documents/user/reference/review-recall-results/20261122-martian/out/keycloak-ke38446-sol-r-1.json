  "findings": [
    {
      "severity": "FAIL",
      "title": "Moving recovery codes to user storage leaves old local codes valid",
      "description": "When `updateCredential()` succeeds, the helper skips the local provider without deleting any existing locally stored recovery-code credential. This affects users who previously configured recovery codes locally and whose federation provider subsequently gains recovery-code support.\n\n`UserCredentialManager.isValid()` falls back to local credential validators when external validation fails, and `RecoveryAuthnCodesCredentialProvider.isValid()` still reads the old local credential. Consequently, an old recovery code can remain usable after the user generates a replacement set.\n\nRemove existing local recovery-code credentials when replacement in user storage succeeds. Add a regression test that starts with local codes, generates replacements in external storage, and verifies that the old codes are rejected.",
      "file_ref": null,
      "category": "security-hygiene",
      "raw_category": null,
      "location": "server-spi-private/src/main/java/org/keycloak/utils/CredentialHelper.java:125-129"
    },
    {
      "severity": "CONCERN",
      "title": "Federated test provider never consumes successful recovery codes",
      "description": "The new validation branch returns whether **any** stored code matches, but never removes the accepted code or advances the next-code state. Meanwhile, `getCredentials()` reconstructs a fresh model from the unchanged full list on every call.\n\nThus, repeated logins can reuse the first recovery code indefinitely, the form keeps requesting code #1, and exhaustion never triggers regeneration. Although this provider is a test fixture, its behavior defeats the one-time recovery-code contract and lets the new integration test pass without exercising consumption.\n\nPersist consumption after successful validation, preserve code numbering, and extend `testRecoveryKeysSetupAndLogin()` to verify replay rejection, advancement to the next code, and regeneration after exhaustion.",
      "file_ref": null,
      "category": "correctness",
      "raw_category": null,
      "location": "testsuite/integration-arquillian/servers/auth-server/services/testsuite-providers/src/main/java/org/keycloak/testsuite/federation/BackwardsCompatibilityUserStorage.java:342"
    }
  ],
